{
    "name": "@o2s/ui",
    "version": "2.0.0",
    "private": true,
    "license": "MIT",
    "description": "Shared UI component library for O2S blocks, built on Radix UI and Tailwind CSS.",
    "keywords": [
        "o2s",
        "ui",
        "components",
        "radix-ui",
        "tailwindcss"
    ],
    "exports": {
        "./globals": "./src/globals.css",
        "./theme": "./src/theme.css",
        "./postcss.config": "./postcss.config.mjs",
        "./lib/*": "./src/lib/*.ts",
        "./hooks/*": "./src/hooks/*.ts",
        "./providers/*": "./src/providers/*/index.ts",
        "./elements/*": "./src/elements/*.tsx",
        "./components/*": "./src/components/*/index.ts",
        "./components/*/*": "./src/components/*/*/index.ts",
        "./components/*/*/*": "./src/components/*/*/*/index.ts",
        "./event-bus": "./src/event-bus/index.ts"
    },
    "scripts": {
        "lint": "tsc --noEmit && eslint . --max-warnings=0",
        "test": "vitest run",
        "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,scss,json}\"",
        "generate:component": "turbo gen react-component",
        "generate:component:shadcn": "npx shadcn@latest add"
    },
    "devDependencies": {
        "@o2s/eslint-config": "*",
        "@o2s/framework": "*",
        "@o2s/lint-staged-config": "*",
        "@o2s/prettier-config": "*",
        "@o2s/typescript-config": "*",
        "@o2s/vitest-config": "*",
        "@storybook/nextjs-vite": "^10.6.0",
        "@storybook/react": "^10.6.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@turbo/gen": "^2.10.12",
        "@types/eslint": "^9.6.1",
        "@types/node": "^26.4.1",
        "@types/throttle-debounce": "^5.0.2",
        "eslint": "^9.39.5",
        "formik": "^2.4.9",
        "prettier": "^3.9.6",
        "sass": "^1.104.0",
        "storybook": "^10.6.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@o2s/configs.integrations": "*",
        "@radix-ui/react-accordion": "^1.2.20",
        "@radix-ui/react-avatar": "^1.2.6",
        "@radix-ui/react-checkbox": "^1.3.11",
        "@radix-ui/react-collapsible": "^1.1.20",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-navigation-menu": "^1.2.22",
        "@radix-ui/react-popover": "^1.1.23",
        "@radix-ui/react-progress": "^1.1.16",
        "@radix-ui/react-radio-group": "^1.4.7",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-switch": "^1.3.7",
        "@radix-ui/react-toast": "^1.2.23",
        "@radix-ui/react-toggle": "^1.1.18",
        "@radix-ui/react-toggle-group": "^1.1.19",
        "@radix-ui/react-tooltip": "^1.2.16",
        "class-variance-authority": "^0.7.1",
        "classnames": "^2.5.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "input-format": "^0.3.14",
        "libphonenumber-js": "^1.13.12",
        "lucide-react": "^1.40.0",
        "markdown-to-jsx": "9.10.2",
        "next": "^16.3.4",
        "next-intl": "^4.14.2",
        "mitt": "^3.0.1",
        "react-day-picker": "^10.0.1",
        "react-indiana-drag-scroll": "^2.2.1",
        "react-string-replace": "^2.0.1",
        "recharts": "^3.10.1",
        "swiper": "^14.2.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss-animate": "^1.0.7",
        "throttle-debounce": "^5.0.2",
        "yup": "^1.7.1"
    },
    "peerDependencies": {
        "@o2s/framework": "*",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "react": "^19",
        "react-dom": "^19",
        "tailwindcss": "^4"
    }
}
