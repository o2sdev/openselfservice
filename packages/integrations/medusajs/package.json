{
    "name": "@o2s/integrations.medusajs",
    "version": "2.0.0",
    "private": false,
    "license": "MIT",
    "description": "MedusaJS integration for O2S, providing ecommerce functionality including products, orders, and carts.",
    "o2sModules": [
        "orders",
        "resources",
        "products",
        "carts",
        "customers",
        "payments",
        "checkout"
    ],
    "keywords": [
        "o2s",
        "integration",
        "medusa",
        "ecommerce",
        "orders"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/o2sdev/openselfservice.git",
        "directory": "packages/integrations/medusajs"
    },
    "homepage": "https://github.com/o2sdev/openselfservice/tree/main/packages/integrations/medusajs#readme",
    "bugs": {
        "url": "https://github.com/o2sdev/openselfservice/issues"
    },
    "exports": {
        "./integration": "./dist/integration.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "test": "vitest run",
        "build": "tsc7 --preserveWatchOutput && tsc-alias",
        "lint": "tsc --noEmit && eslint . --max-warnings=0",
        "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,scss,json}\""
    },
    "dependencies": {
        "@medusajs/js-sdk": "^2.20.1",
        "@medusajs/types": "^2.20.1",
        "@o2s/utils.logger": "*",
        "slugify": "^1.6.9"
    },
    "devDependencies": {
        "@o2s/eslint-config": "*",
        "@o2s/framework": "*",
        "@o2s/lint-staged-config": "*",
        "@o2s/prettier-config": "*",
        "@o2s/typescript-config": "*",
        "@o2s/vitest-config": "*",
        "concurrently": "^10.0.5",
        "eslint": "^9.39.5",
        "prettier": "^3.9.6",
        "tsc-alias": "^1.9.4",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "@o2s/framework": "*",
        "@nestjs/axios": "^12.0.0",
        "@nestjs/common": "^12.0.0",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "rxjs": "^7"
    }
}
