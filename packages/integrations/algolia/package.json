        "directory": "packages/integrations/algolia"
    },
    "homepage": "https://github.com/o2sdev/openselfservice/tree/main/packages/integrations/algolia#readme",
    "bugs": {
        "url": "https://github.com/o2sdev/openselfservice/issues"
    },
    "exports": {
        "./integration": "./dist/integration.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "test": "vitest run",
        "build": "tsc --preserveWatchOutput && tsc-alias",
