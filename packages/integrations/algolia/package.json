{
    "name": "@o2s/integrations.algolia",
    "version": "2.0.0",
    "private": false,
    "license": "MIT",
    "description": "Algolia integration for O2S, providing search functionality.",
    "o2sModules": [
        "search"
    ],
    "keywords": [
        "o2s",
        "integration",
        "algolia",
        "search"
    ],
