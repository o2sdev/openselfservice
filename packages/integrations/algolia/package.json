        "@o2s/prettier-config": "*",
        "@o2s/typescript-config": "*",
        "@o2s/vitest-config": "*",
        "concurrently": "^10.0.5",
        "eslint": "^9.39.5",
        "prettier": "^3.9.6",
        "tsc-alias": "^1.9.3",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "@o2s/framework": "*",
        "@nestjs/axios": "^12.0.0",
        "@nestjs/common": "^12.0.0",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "rxjs": "^7"
    }
