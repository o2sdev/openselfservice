{
    "name": "@o2s/modules.documents",
    "version": "0.0.1",
    "private": true,
    "license": "MIT",
    "description": "Custom Documents module for O2S.",
    "keywords": [
        "o2s",
        "module",
        "documents"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/o2sdev/openselfservice.git",
        "directory": "packages/modules/documents"
    },
    "homepage": "https://github.com/o2sdev/openselfservice/tree/main/packages/modules/documents#readme",
    "bugs": {
        "url": "https://github.com/o2sdev/openselfservice/issues"
    },
    "exports": {
        ".": "./dist/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc7 --preserveWatchOutput && tsc-alias",
        "test": "vitest run",
        "lint": "tsc --noEmit && eslint . --max-warnings=0",
        "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,scss,json}\""
    },
    "dependencies": {
        "@o2s/framework": "*",
        "@o2s/utils.logger": "*"
    },
    "devDependencies": {
        "@o2s/eslint-config": "*",
        "@o2s/lint-staged-config": "*",
        "@o2s/prettier-config": "*",
        "@o2s/typescript-config": "*",
        "@o2s/vitest-config": "*",
        "concurrently": "^10.0.5",
        "eslint": "^9.39.5",
        "prettier": "^3.9.6",
        "tsc-alias": "^1.9.4",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "@nestjs/axios": "^12.0.0",
        "@nestjs/common": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "rxjs": "^7"
    }
