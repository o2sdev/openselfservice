{
    "name": "@o2s/integrations.{{kebabCase name}}",
    "version": "0.0.1",
    "private": false,
    "license": "MIT",
    "description": "{{pascalCase name}} integration for O2S.",
    "keywords": [
        "o2s",
        "integration",
        "{{kebabCase name}}"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/o2sdev/openselfservice.git",
        "directory": "packages/integrations/{{kebabCase name}}"
    },
    "homepage": "https://github.com/o2sdev/openselfservice/tree/main/packages/integrations/{{kebabCase name}}#readme",
    "bugs": {
        "url": "https://github.com/o2sdev/openselfservice/issues"
    },
    "exports": {
        "./integration": "./dist/integration.js",
        "./sdk": "./dist/sdk/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc7 --preserveWatchOutput && tsc-alias",
        "test": "vitest run",
        "lint": "tsc --noEmit && eslint . --max-warnings=0",
        "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,scss,json}\""
    },
    "dependencies": {
        "@o2s/framework": "*",
        "@o2s/utils.logger": "*"
    },
    "devDependencies": {
        "@o2s/eslint-config": "*",
        "@o2s/lint-staged-config": "*",
        "@o2s/prettier-config": "*",
        "@o2s/typescript-config": "*",
        "@o2s/vitest-config": "*",
        "concurrently": "^10.0.5",
        "eslint": "^9.39.5",
        "prettier": "^3.9.6",
        "tsc-alias": "^1.9.3",
        "typescript": "^6.0.3"
    },
    "o2sTemplate": [{{#each templates}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}],
    "peerDependencies": {
        "@nestjs/axios": "^12.0.0",
        "@nestjs/common": "^12.0.0",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "rxjs": "^7"
    }
}
