        "@o2s/blocks.bento-grid": "*",
        "@o2s/blocks.cart": "*",
        "@o2s/blocks.category": "*",
        "@o2s/blocks.category-list": "*",
        "@o2s/blocks.checkout-billing-payment": "*",
        "@o2s/blocks.checkout-company-data": "*",
