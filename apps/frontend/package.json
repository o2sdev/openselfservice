        "@o2s/eslint-config": "*",
        "@o2s/lint-staged-config": "*",
        "@o2s/prettier-config": "*",
        "@o2s/typescript-config": "*",
        "@o2s/vitest-config": "*",
        "@svgr/webpack": "^8.1.0",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@turbo/gen": "^2.10.12",
