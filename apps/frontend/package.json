        "@o2s/configs.integrations": "*",
        "@o2s/framework": "*",
        "@o2s/integrations.mocked": "*",
        "@o2s/ui": "*",
        "@o2s/utils.api-harmonization": "*",
        "@o2s/utils.frontend": "*",
        "class-variance-authority": "^0.7.1",
        "date-fns": "^4.4.0",
        "dotenv-cli": "^11.0.0",
        "formik": "^2.4.9",
        "markdown-to-jsx": "9.10.2",
        "next": "16.3.4",
