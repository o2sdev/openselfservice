{
    "name": "@o2s/docs",
    "version": "2.3.0",
    "private": true,
    "scripts": {
        "docusaurus": "docusaurus",
        "generate:openapi:snapshot": "node ./scripts/fetch-openapi-for-redocly.mjs",
        "generate:api-pages:openapi": "docusaurus clean-api-docs all && docusaurus gen-api-docs all && node ./scripts/post-generate-api-docs.mjs",
        "generate:api-reference:redocly": "redocly build-docs ./static/openapi/framework-live.json --output ./static/api/reference/index.html --title \"O2S API Reference\"",
        "generate:docs": "npm run generate:api-pages:openapi && npm run generate:api-reference:redocly",
        "generate:docs:refresh": "npm run generate:openapi:snapshot && npm run generate:docs",
        "start": "cross-env CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=1000 docusaurus start --port 3006",
        "build": "npm run generate:docs && docusaurus build",
        "swizzle": "docusaurus swizzle",
        "deploy": "docusaurus deploy",
        "clear": "docusaurus clear",
        "serve": "docusaurus serve",
        "write-translations": "docusaurus write-translations",
        "write-heading-ids": "docusaurus write-heading-ids",
        "typecheck": "tsc",
        "lint": "tsc --noEmit && eslint \"src/**/*.{ts,tsx}\" --fix --max-warnings=0",
        "format": "prettier --write \"{src,docs,blog}/**/*.{js,jsx,ts,tsx,css,scss,json,md}\""
    },
    "dependencies": {
        "@o2s/framework": "*",
        "@o2s/utils.logger": "*",
        "@docusaurus/core": "^3.10.2",
        "@docusaurus/plugin-content-blog": "^3.10.2",
        "@docusaurus/plugin-content-docs": "^3.10.2",
        "@docusaurus/plugin-google-gtag": "^3.10.2",
        "@docusaurus/plugin-google-tag-manager": "^3.10.2",
        "@docusaurus/preset-classic": "^3.10.2",
        "@docusaurus/theme-common": "^3.10.2",
        "@docusaurus/theme-mermaid": "^3.10.2",
        "@easyops-cn/docusaurus-search-local": "^0.55.3",
        "@mdx-js/react": "^3.1.1",
        "@o2s/ui": "*",
        "@radix-ui/react-accordion": "^1.2.20",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "clsx": "^2.1.1",
        "docusaurus-plugin-image-zoom": "^3.0.1",
        "docusaurus-plugin-openapi-docs": "^5.2.0",
        "docusaurus-plugin-sass": "^0.2.7",
        "docusaurus-theme-openapi-docs": "^5.2.0",
        "motion": "^13.2.0",
        "path-browserify": "^1.0.1",
        "prism-react-renderer": "^2.4.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "sass": "^1.104.0",
        "vanilla-cookieconsent": "^3.1.0"
    },
    "devDependencies": {
        "@docusaurus/module-type-aliases": "^3.10.2",
        "@redocly/cli": "^2.51.1",
        "@docusaurus/tsconfig": "^3.10.2",
        "@docusaurus/types": "^3.10.2",
        "@o2s/eslint-config": "*",
        "@o2s/lint-staged-config": "*",
        "@o2s/prettier-config": "*",
        "@o2s/typescript-config": "*",
        "@tailwindcss/postcss": "^4.3.3",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "autoprefixer": "^10.5.4",
        "postcss": "^8.5.28",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.3.3",
        "typescript": "6.0.3"
    },
    "browserslist": {
        "production": [
            ">0.5%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 3 chrome version",
            "last 3 firefox version",
            "last 5 safari version"
        ]
    },
    "engines": {
        "node": ">=18.0"
    }
}
